# Environment Variables Example
# Copy this file to .env and replace the values with your actual secrets

# Example database connection string
DATABASE_URL="postgres://user:password@localhost:5432/dbname"

# Example API key
NEXT_PUBLIC_API_URL="https://api.example.com"
API_SECRET_KEY="sk_test_..."

# Website enquiries: set these in .env.local and the hosting environment.
# Recipients are configured server-side. Never use NEXT_PUBLIC_ for credentials.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender must be authorised by the mailbox provider.
SMTP_FROM="Rely Advisory Group <info@relyadvisory.com.au>"

# Required: comma-separated inboxes for newsletter signup requests.
MAIL_RECIPIENTS=""

# Required: comma-separated private recipients for contact and review forms.
FORM_MAIL_RECIPIENTS=""
